# Strato HiDrive Configuration
STRATO_HIDRIVE_WEBDAV_URL=https://webdav.hidrive.strato.com
STRATO_HIDRIVE_USERNAME=your_hidrive_username
STRATO_HIDRIVE_PASSWORD=your_hidrive_password
STRATO_HIDRIVE_SSH_HOST=sftp.hidrive.strato.com
STRATO_HIDRIVE_SSH_PORT=22
STRATO_HIDRIVE_SSH_KEY_PATH=~/.ssh/id_rsa

# Strato HiDrive REST API (Optional for Quota & Sharelinks)
STRATO_HIDRIVE_API_CLIENT_ID=your_client_id
STRATO_HIDRIVE_API_CLIENT_SECRET=your_client_secret
STRATO_HIDRIVE_API_REFRESH_TOKEN=your_refresh_token

# Strato Webhosting Configuration
STRATO_WEBHOSTING_SSH_HOST=ssh.strato.de
STRATO_WEBHOSTING_SSH_PORT=22
STRATO_WEBHOSTING_SSH_USER=your_webhosting_ssh_user
STRATO_WEBHOSTING_SSH_KEY_PATH=~/.ssh/id_rsa
STRATO_WEBHOSTING_WEBROOT=/home/strato/www/yourdomain

# Strato Webhosting MySQL/MariaDB Config
STRATO_DB_HOST=rdbms.strato.de
STRATO_DB_USER=your_db_user
STRATO_DB_PASSWORD=your_db_password
STRATO_DB_NAME=your_db_name

# Target Domain for Health & SSL Monitoring
STRATO_TARGET_DOMAIN=https://yourdomain.de
